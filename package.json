{
  "name": "@wordvel/typescript",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./tooling": {
      "types": "./src/tooling.d.ts",
      "default": "./src/tooling.js"
    }
  },
  "bin": {
    "wordvel-typescript": "bin/wordvel-typescript.js",
    "wordvel-ts": "bin/wordvel-typescript.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "description": "Framework-agnostic TypeScript SDK foundation for WordVel SPA integrations"
}
